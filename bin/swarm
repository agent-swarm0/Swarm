// ─────────────────────────────────────────────────────────────
// Splash screen
// ─────────────────────────────────────────────────────────────
const SPINNER = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
const pick = (arr) => arr[Math.floor(Math.random() * arr.length)];
const sleep = (ms) => new Promise(r => setTimeout(r, ms));

async function animateProgressBar(width, durationMs) {
  const steps = Math.floor(durationMs / 25);
  // Primary mint → secondary blue → warm coral
  const rgb = [
    [0x7b, 0xd2, 0x89],
    [0x48, 0x95, 0xef],
    [0xff, 0x8e, 0x53],
  ];
  const lerp = (a, b, u) => Math.round(a + (b - a) * u);
  for (let i = 0; i <= steps; i++) {
    const filled = Math.round((i / steps) * width);
    const empty = width - filled;
    const t = i / steps;
    let r; let g; let b;
    if (t < 0.5) {
      const u = t * 2;
      r = lerp(rgb[0][0], rgb[1][0], u);
      g = lerp(rgb[0][1], rgb[1][1], u);
      b = lerp(rgb[0][2], rgb[1][2], u);
    } else {
      const u = (t - 0.5) * 2;
      r = lerp(rgb[1][0], rgb[2][0], u);
      g = lerp(rgb[1][1], rgb[2][1], u);
      b = lerp(rgb[1][2], rgb[2][2], u);
    }
    const barColor = `#${r.toString(16).padStart(2,'0')}${g.toString(16).padStart(2,'0')}${b.toString(16).padStart(2,'0')}`;
    const filledStr = applyHex(barColor, '█'.repeat(filled));
    const emptyStr = applyDim('░'.repeat(empty));
    out('\r  ' + filledStr + emptyStr);
    if (i < steps) await sleep(25);
  }
}

async function animateSpinner(durationMs, msg) {
  let i = 0;
  const end = Date.now() + durationMs;
  while (Date.now() < end) {
    out('\r  ' + applyPrimary(SPINNER[i % SPINNER.length]) + ' ' + applyDim(msg) + '   ');
    i++;
    await sleep(80);
  }
}

async function showSplash() {
  if (skipSplash) return 0;

  out(HIDE_CURSOR);
  const termWidth = process.stdout.columns || 80;
  let lineCount = 0;

  const writeln = (text = '') => { out('  ' + text + '\n'); lineCount++; };
  const blankln = () => { out('\n'); lineCount++; };

  // ── top margin
  blankln();

  // ── AGENT lines with gradient + stagger
  for (let i = 0; i < AGENT_LINES.length; i++) {
    writeln(applyHex(AGENT_COLORS[i], AGENT_LINES[i]));
    await sleep(20);
  }

  blankln();

  // ── SWARM lines with gradient + stagger
  for (let i = 0; i < SWARM_LINES.length; i++) {
    writeln(applyHex(SWARM_COLORS[i], SWARM_LINES[i]));
    await sleep(20);
  }

  blankln();

  // ── separator
  const sepWidth = Math.min(termWidth - 6, 46);
  writeln(applyDim('─'.repeat(sepWidth)));

  // ── subtitle row
  const subtitle =
    applyBold(applyPrimary('Multi-Agent AI Orchestration')) +
    applyDim(' · ') +
    applyHex(SWARM_SECONDARY_BLUE, '245+ Agents') +
    applyDim(' · ') +
    applyDim('v' + version);
  writeln(subtitle);

  blankln();

  // ── witty boot phrase
  const phrase = pick(BOOT_PHRASES);
  writeln(applyDim(applyItalic(phrase)));

  blankln();

  // ── animated progress bar
  const barWidth = Math.min(termWidth - 8, 44);
  out('  '); // left pad — not counted in lineCount (same line as bar)
  await animateProgressBar(barWidth, 380);
  out('\n'); lineCount++;

  // ── spinner
  const loadMsg = pick(LOADING_MSGS);
  await animateSpinner(350, loadMsg);

  // ── clear spinner line
  out('\r' + CLEAR_LINE);

  // ── small pause then clear everything
  await sleep(60);
  out(moveUp(lineCount) + ERASE_DOWN);
  out(SHOW_CURSOR);

  return lineCount;
}

// ─────────────────────────────────────────────────────────────
// Handle SIGINT during splash (restore cursor)
// ─────────────────────────────────────────────────────────────
let splashComplete = false;
process.on('SIGINT', () => {
  if (!splashComplete) out(SHOW_CURSOR);
  process.exit(0);
});

// ─────────────────────────────────────────────────────────────
// Run splash → launch child
// ─────────────────────────────────────────────────────────────
await showSplash();
splashComplete = true;

const rawArgs = process.argv.slice(2);
const dashboard = await startDashboard(rawArgs);
if (dashboard) {
  const status = dashboard.ready ? 'running' : 'starting';
  process.stdout.write(
    '\n' +
      applyBold(applyPrimary(`  Dashboard ${status}: ${dashboard.url}`)) +
      '\n' +
      applyDim('  Non-technical users can use this local browser dashboard. Keep this terminal open while it runs.') +
      '\n\n',
  );
}

const child = spawn(process.execPath, [entry, ...stripLauncherArgs(rawArgs)], {
  cwd: process.cwd(),
  stdio: 'inherit',
  env: {
    ...process.env,
    SWARM_ROOT,
  },
});

child.on('exit', (code) => {
  if (dashboard?.child && !dashboard.child.killed) {
    dashboard.child.kill();
  }
  const exitCode = code ?? 0;
  if (isTTY && exitCode === 0 && !process.env.CI && !process.env.NO_SPLASH) {
    process.stdout.write('\n' + applyDim('  ' + pick(EXIT_PHRASES)) + '\n\n');
  }
  process.exit(exitCode);
});

child.on('error', (err) => {
  out(SHOW_CURSOR);
  process.stderr.write(`swarm: failed to start (${entry}): ${err.message}\n`);
  process.stderr.write('Run `npm run build` in the package if dist/ is missing.\n');
  process.exit(1);
});
