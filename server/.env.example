# ──────────────────────────────────────────────────────────────
# SWARM v1.0 backend — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env` (git-ignored).
# No API keys are ever hardcoded in source — they live here only.
# ──────────────────────────────────────────────────────────────

# HTTP server
PORT=8787
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins (the dashboard).
# Next.js dev server defaults to :3000.
CORS_ORIGINS=http://localhost:3000

# Logging: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# Node environment: "development" | "production"
NODE_ENV=development

# Max runs executing concurrently. Overrides swarm.config.json api_mode.concurrency_cap.
# Leave unset to use the config value (default 5). Excess runs are queued.
# SWARM_CONCURRENCY_CAP=5

# API rate limiting (applies to /api/*, not /health).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Proxy hops to trust for client IP. Railway/Render = 1. Must be a count,
# never `true`, so IP rate limiting cannot be spoofed.
TRUST_PROXY_HOPS=1

# Path to swarm.config.json when not at the repo-root default (e.g. in Docker).
# SWARM_CONFIG_PATH=/app/swarm.config.json

# ──────────────────────────────────────────────────────────────
# Provider API keys (OPTIONAL on the server).
# In API mode the dashboard sends the user's key per-request, so the
# server does NOT require these. They exist only as an optional
# server-side fallback for local testing. Leave blank in production.
# ──────────────────────────────────────────────────────────────
# The Node-side orchestrator uses Gemini first, then falls back to DeepSeek.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Optional model overrides for the orchestrator.
# GEMINI_MODEL=gemini-2.5-flash
# DEEPSEEK_MODEL=deepseek-chat
