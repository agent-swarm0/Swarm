# ──────────────────────────────────────────────────────────────
# SWARM v1.0 backend — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env` (git-ignored).
# No API keys are ever hardcoded in source — they live here only.
# ──────────────────────────────────────────────────────────────

# HTTP server
PORT=8787
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins (the dashboard).
# Next.js dev server defaults to :3000.
CORS_ORIGINS=http://localhost:3000

# Logging: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# Node environment: "development" | "production"
NODE_ENV=development

# ──────────────────────────────────────────────────────────────
# Provider API keys (OPTIONAL on the server).
# In API mode the dashboard sends the user's key per-request, so the
# server does NOT require these. They exist only as an optional
# server-side fallback for local testing. Leave blank in production.
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
