{
  "name": "@swarm/server",
  "version": "0.1.0",
  "private": true,
  "description": "SWARM v1.0 backend — Express + TypeScript API/WS layer for API-mode multi-agent runs.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx \"test/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "@types/ws": "^8.5.13",
    "nodemon": "^3.1.9",
    "tsx": "^4.22.3",
    "typescript": "^5.7.3"
  }
}
